{
  "name": "forge-launcher",
  "version": "1.0.0-beta.6",
  "type": "module",
  "description": "One command from zero to auto-build: creates a repo, bootstraps MyForge, captures your idea, and launches the full pipeline. Cross-platform launcher for bootstrap, authoring, and service-backed runs.",
  "bin": {
    "forge-launcher": "dist/cli.js"
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && node scripts/copy-client-assets.mjs",
    "test": "node --import tsx --test --test-concurrency=1 scripts/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:version": "tsx scripts/version-consistency.ts",
    "prepack": "npm run build && node scripts/stage-resources.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@dapr/dapr": "3.18.0",
    "@clack/prompts": "^1.7.0",
    "cross-spawn": "^7.0.6",
    "gray-matter": "^4.0.3",
    "pg": "^8.23.1",
    "read-cmd-shim": "^5.0.0",
    "semver": "^7.8.5",
    "which": "^5.0.0",
    "tsx": "^4.23.13"
  },
  "overrides": {
    "argparse": "2.0.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.8.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
