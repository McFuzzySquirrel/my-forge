{
  "name": "@myforge/dapr-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable execution boundary and future Dapr workflow service",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:postgres": "node --import tsx --test tests/storage/postgres-operation-receipts.integration.test.ts tests/storage/postgres-repository-integration.integration.test.ts tests/storage/postgres-operation-executions.integration.test.ts tests/storage/postgres-control-records.integration.test.ts tests/storage/postgres-run-status.integration.test.ts tests/storage/postgres-host-runner-jobs.integration.test.ts tests/storage/p3-gate.integration.test.ts tests/orchestration/execution-host.integration.test.ts",
    "verify:execution": "node --import tsx scripts/verify-execution.ts",
    "measure:bounds": "node --import tsx scripts/measure-bounds.ts"
  },
  "dependencies": {
    "@dapr/dapr": "3.18.0",
    "cross-spawn": "^7.0.6",
    "pg": "^8.23.1",
    "read-cmd-shim": "^5.0.0",
    "which": "^5.0.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true
  }
}
