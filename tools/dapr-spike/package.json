{
  "name": "dapr-spike",
  "version": "1.0.0",
  "description": "Isolated released Dapr Workflow and rootless Podman durability spike",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && node --test spike.test.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "setup": "npm run build && node cli.js setup",
    "spike": "npm run build && node cli.js",
    "test:stack": "npm run setup && node cli.js verify"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@dapr/dapr": "3.18.0"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true
  }
}
